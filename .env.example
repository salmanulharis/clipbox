# ─────────────────────────────────────────────────────────────
#  ClipBox configuration — copy to .env and adjust as needed.
#  Every value is optional; the defaults work out of the box.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# Interface to bind. 0.0.0.0 = reachable from your local network.
# Use 127.0.0.1 to allow only this machine (and tunnels).
HOST=0.0.0.0
PORT=3210

# Where clipboards and uploaded files are stored.
DATA_DIR=./data

# ── Authentication ───────────────────────────────────────────
# Password for remote access. Remote/tunnel requests are ALWAYS
# refused unless this is set.
AUTH_PASSWORD=

# public = devices on your LAN need no password; remote (tunnel)
#          requests must log in.            (default)
# all    = every device must log in, including LAN devices.
AUTH_MODE=public

# How long a login stays valid (days).
SESSION_DAYS=30

# Extra host names that count as "local" (comma separated),
# e.g. a hostname you set up in your router's DNS.
# IP addresses, localhost, <computer-name> and *.local are always local.
LOCAL_HOSTNAMES=

# ── Public access / tunnels ──────────────────────────────────
# none | ngrok | cloudflare
TUNNEL=none

# true = ClipBox launches the tunnel program for you.
# false = you run ngrok/cloudflared yourself (ClipBox still
#         detects the ngrok URL automatically).
TUNNEL_AUTOSTART=false

# Fixed public URL (e.g. a Cloudflare named tunnel or a reverse
# proxy). Overrides auto-detection when set.
PUBLIC_URL=

# ngrok options
NGROK_BIN=ngrok
NGROK_API=http://127.0.0.1:4040
# Reserved/static ngrok domain (optional), e.g. my-clips.ngrok-free.app
NGROK_DOMAIN=

# Cloudflare options
CLOUDFLARED_BIN=cloudflared
# Token of a named tunnel (optional). Without it a free "quick tunnel"
# (*.trycloudflare.com) is created. With it, also set PUBLIC_URL.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Limits ───────────────────────────────────────────────────
# Maximum size of one text item (KB) and one file/image (MB).
MAX_TEXT_KB=1024
MAX_FILE_MB=25
# Maximum size of one shared note (KB).
NOTE_MAX_KB=256

# ── Optional local HTTPS ─────────────────────────────────────
# Paths to a certificate + key. Enables HTTPS on the LAN, which
# unlocks the live camera scanner and image copy on phones.
HTTPS_CERT=
HTTPS_KEY=
