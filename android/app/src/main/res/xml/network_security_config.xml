<?xml version="1.0" encoding="utf-8"?>
<!--
  ClipBox servers on a home/office network usually run plain http on a private IP, which Android
  can't express as a domain rule. Cleartext is therefore permitted here, and the app enforces the
  real policy in code (UrlPolicy): http only for private/local addresses, https for everything else.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
